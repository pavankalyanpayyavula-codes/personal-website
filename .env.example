# Copy this file to .env and fill in your values. .env is git-ignored.
# The same two values go in Vercel → Project → Settings → Environment Variables.

# Your Gmail address. Contact form messages are sent from and delivered to it.
EMAIL_USER=you@gmail.com

# A Gmail App Password (16 characters, needs 2-Step Verification):
# https://myaccount.google.com/apppasswords
EMAIL_PASS=
